# ============ Frontend (browser-exposed, must start with VITE_) ============
VITE_API_URL=https://apidiamond99.codefactory.games/api
VITE_SOCKET_URL=https://apidiamond99.codefactory.games
VITE_THEME=light

# Whitelabel brand identifier. Looked up against src/styles/themes/<brand>.css
# and the <html data-brand="..."> attribute. Defaults to subdomain when unset.
VITE_BRAND=default

# Casino video stream base URL (game id appended as ?id=<gameId>)
VITE_CASINO_STREAM_URL=https://stream-s-43.uhdmovies.online/casino-stream

# Sports live TV stream base URL (match gmid appended as ?id=<gmid>)
VITE_SPORTS_STREAM_URL=https://stream-s-43.uhdmovies.online/sports-stream

# Sports scorecard iframe base URL (queried as /?etid=<sid>&gmid=<gmid>)
VITE_SCORECARD_URL=https://scorecard.daimond-api.site
